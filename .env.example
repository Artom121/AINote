# Скопируйте в .env и заполните. Значения в репозиторий не коммитятся.

# PostgreSQL (локально — из docker-compose.yml, порт 5433)
DATABASE_URL=
# База для интеграционных тестов (создаётся docker/postgres-init)
TEST_DATABASE_URL=

# Auth.js: секрет подписи (сгенерировать: openssl rand -base64 32)
AUTH_SECRET=
# Публичный адрес приложения, например http://localhost:3000
AUTH_URL=
# true, если приложение стоит за обратным прокси (nginx и т. п.)
AUTH_TRUST_HOST=

# Яндекс ID OAuth (https://oauth.yandex.ru/client/new)
# Callback URL: <AUTH_URL>/api/auth/callback/yandex
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=
